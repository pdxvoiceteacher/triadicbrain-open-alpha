{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uvlm.sonya.totality.candidate_packet.v1",
  "x-uvlm-contract-layering": {
    "json_schema_role": "structural_validation",
    "required_semantic_validator": "coherence.totality.adapter.validate_candidate_packet",
    "semantic_rules_not_expressible_portably_in_draft_2020_12": [
      "Unicode NFC normalization and default-ignorable/control-code rejection",
      "candidate identifier derivation from request and raw-output hashes",
      "claim text exact-span binding to the answer",
      "candidate evidence claim-text hash binding and positive span ordering"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "candidate_id", "run_id", "logical_time", "request_sha256", "adapter_id", "model_identity", "raw_output_sha256", "answer", "uncertainty", "claims", "candidate_not_final_answer", "model_output_not_authority", "not_truth_certification", "not_memory_authorization", "not_training_authorization", "not_publication_authorization", "not_deployment_authority", "not_release_authorization", "human_review_required"],
  "properties": {
    "schema_id": {"const": "uvlm.sonya.totality.candidate_packet.v1"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "logical_time": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "[^\\s]"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "model_identity": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "[^\\s]"},
    "raw_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer": {"type": "string", "minLength": 1, "maxLength": 200000, "pattern": "[^\\s]"},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "text", "answer_start", "answer_end", "candidate_evidence_references"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "text": {"type": "string", "minLength": 1},
          "answer_start": {"type": "integer", "minimum": 0},
          "answer_end": {"type": "integer", "minimum": 1},
          "candidate_evidence_references": {
            "type": "array", "maxItems": 100, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_sha256", "segment_id", "segment_sha256", "source_span", "exact_excerpt_sha256", "claim_text_sha256", "candidate_relation"],
              "properties": {
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "segment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
                "segment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source_span": {
                  "type": "object", "additionalProperties": false,
                  "required": ["byte_start", "byte_end", "char_start", "char_end"],
                  "properties": {
                    "byte_start": {"type": "integer", "minimum": 0},
                    "byte_end": {"type": "integer", "minimum": 1},
                    "char_start": {"type": "integer", "minimum": 0},
                    "char_end": {"type": "integer", "minimum": 1}
                  }
                },
                "exact_excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "claim_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "candidate_relation": {"enum": ["SUPPORTS", "LIMITS", "CONTRADICTS"]}
              }
            }
          }
        }
      }
    },
    "candidate_not_final_answer": {"const": true},
    "model_output_not_authority": {"const": true},
    "not_truth_certification": {"const": true},
    "not_memory_authorization": {"const": true},
    "not_training_authorization": {"const": true},
    "not_publication_authorization": {"const": true},
    "not_deployment_authority": {"const": true},
    "not_release_authorization": {"const": true},
    "human_review_required": {"const": true}
  }
}
