{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uvlm.coherence.totality.grounding_bundle.v1",
  "x-uvlm-contract-layering": {
    "json_schema_role": "grounding_manifest_structural_validation",
    "required_semantic_validator": "coherence.totality.grounding.validate_grounding_bundle",
    "semantic_rules_not_expressible_portably_in_draft_2020_12": [
      "source UTF-8 decoding, line-ending normalization, NFC, and default-ignorable rejection",
      "source and normalized byte-count and SHA-256 recomputation",
      "segment ordering, exact character/byte spans, and segments JSONL SHA-256 recomputation"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "bundle_id", "source_sha256", "normalized_sha256", "source_bytes", "normalized_bytes", "segments_sha256", "segment_count", "segmentation", "authority_effect", "network_used"],
  "properties": {
    "schema_id": {"const": "uvlm.coherence.totality.grounding_bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bytes": {"type": "integer", "minimum": 1},
    "normalized_bytes": {"type": "integer", "minimum": 1},
    "segments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segment_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "segmentation": {"const": "PARAGRAPH_THEN_NONEMPTY_LINE_EXACT_SPAN_UTF8_NFC_V1"},
    "authority_effect": {"const": "NONE"},
    "network_used": {"const": false}
  }
}
